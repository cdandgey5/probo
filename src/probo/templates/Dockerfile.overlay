# Generated by probo convert for task {task_id}. Do not edit; edit the task.
#
# Overlay on an image that already holds the repository at {repo_path}
# (for example a MobileDev-Bench instance image, see
# docs/mobiledev-bench-images.md). It adds what the grader needs: git and
# python3, the repository as a one-commit git repository at /app with no
# remote and no upstream history, a single read-only dependency cache, the
# pinned Gradle distribution at /opt/gradle/dist, and offline probes of both
# paths. It also removes anything the base image left next to the checkout,
# in particular a baked-in gold patch, so the agent cannot read the answer.
FROM {image_with_repo}

ENV DEBIAN_FRONTEND=noninteractive
RUN (command -v git > /dev/null && command -v python3 > /dev/null) \
 || (apt-get update \
     && apt-get install -y --no-install-recommends git python3 ca-certificates \
     && rm -rf /var/lib/apt/lists/*)

# Nothing but the repository may remain next to it: MobileDev-Bench images
# carry /home/fix.patch, /home/test.patch and their run scripts.
RUN rm -f /home/fix.patch /home/test.patch /home/*.sh /home/*.py /home/gradle.properties; \
    find "$(dirname "{repo_path}")" -maxdepth 1 -type f -delete

# The repository must live at /app for Harbor's conventions and the grader.
RUN if [ "{repo_path}" != "/app" ]; then rm -rf /app && ln -s "{repo_path}" /app; fi
WORKDIR /app

# One local commit at the base state, no remote, no unreachable refs. The
# base image's .git (a full clone whose history contains the merged fix) is
# replaced, so nothing upstream is reachable from inside the container.
RUN rm -rf .git \
 && git init -q -b main \
 && git config user.email "task@example.invalid" \
 && git config user.name "task" \
 && git add -A \
 && git commit -q -m "base"

# Warm Gradle home. Reuse the cache the base image built (its default
# GRADLE_USER_HOME, or /tmp/.gradle for images whose scripts set that), then
# make sure the wrapper distribution and every dependency of the test tasks
# are present. The test run may fail (tests can be red at base).
ENV GRADLE_USER_HOME=/opt/gradle/warm
RUN mkdir -p /opt/gradle \
 && if [ -d /root/.gradle ]; then mv /root/.gradle /opt/gradle/warm; \
    elif [ -d /tmp/.gradle ]; then mv /tmp/.gradle /opt/gradle/warm; fi \
 && chmod +x gradlew \
 && ./gradlew --no-daemon --console=plain help \
 && (./gradlew --no-daemon --console=plain --continue {test_tasks} || true) \
 && ./gradlew --no-daemon --console=plain clean

# Single read-only dependency cache and the pinned distribution, as in the
# inline template.
RUN set -e; \
    dist="$(dirname "$(dirname "$(find /opt/gradle/warm/wrapper/dists -type f -path '*/bin/gradle')")")"; \
    ln -s "$dist" /opt/gradle/dist; \
    mkdir -p /opt/gradle/ro-cache; \
    mv /opt/gradle/warm/caches/modules-2 /opt/gradle/ro-cache/modules-2; \
    find /opt/gradle/ro-cache -name '*.lock' -delete; \
    rm -f /opt/gradle/ro-cache/modules-2/gc.properties; \
    chmod -R a-w /opt/gradle/ro-cache; \
    find /opt/gradle/warm/wrapper/dists -name '*.zip' -delete
ENV GRADLE_RO_DEP_CACHE=/opt/gradle/ro-cache

# Offline probes: the grader's path (fresh home, pinned binary) must write
# JUnit XML; the agent's ./gradlew must still work from the warm home.
RUN GRADLE_USER_HOME=/tmp/probe-home \
      /opt/gradle/dist/bin/gradle --offline --no-daemon --console=plain --continue {test_tasks}; \
    {probe_check} \
 && ./gradlew --offline --no-daemon --console=plain help > /dev/null \
 && rm -rf /tmp/probe-home && ./gradlew --no-daemon --console=plain clean > /dev/null \
 && rm -rf .gradle .kotlin

RUN id -u agent > /dev/null 2>&1 || useradd -m -u 1000 agent; \
    chown -R agent:agent /app/ /opt/gradle/warm
