# Generated by probo convert for task {task_id}. Do not edit; edit the task.
#
# Gradle project with every dependency pre-fetched so grading can run with
# --offline in a container that has no network. One read-only dependency cache
# serves both the agent's ./gradlew and the grader's pinned Gradle binary.
FROM {base_image}

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends git python3 ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Warm Gradle home: wrapper distribution plus dependency cache, filled at build.
ENV GRADLE_USER_HOME=/opt/gradle/warm

WORKDIR /app
COPY repo/ /app/

# The repository at its base commit: one local commit, no remote, no
# unreachable refs, so the agent has nothing to fetch and every change shows
# up in `git diff HEAD`.
RUN chmod +x gradlew \
 && git init -q -b main \
 && git config user.email "task@example.invalid" \
 && git config user.name "task" \
 && git add -A \
 && git commit -q -m "base"

# Pre-fetch the wrapper distribution and every compile and test-runtime
# dependency. The test run may fail (tests can be red at base); it only has to
# resolve the test runtime classpath.
RUN ./gradlew --no-daemon --console=plain help \
 && (./gradlew --no-daemon --console=plain --continue {test_tasks} || true) \
 && ./gradlew --no-daemon --console=plain clean

# Single read-only dependency cache: move modules-2 out of the warm home so
# nothing is stored twice, drop the lock files, make it unwritable, and point
# every Gradle invocation in the image at it. The grader additionally runs the
# pinned distribution binary /opt/gradle/dist/bin/gradle (never the project's
# gradlew, which an agent could replace) with a fresh GRADLE_USER_HOME.
RUN set -e; \
    dist="$(dirname "$(dirname "$(find /opt/gradle/warm/wrapper/dists -type f -path '*/bin/gradle')")")"; \
    ln -s "$dist" /opt/gradle/dist; \
    mkdir -p /opt/gradle/ro-cache; \
    mv /opt/gradle/warm/caches/modules-2 /opt/gradle/ro-cache/modules-2; \
    find /opt/gradle/ro-cache -name '*.lock' -delete; \
    rm -f /opt/gradle/ro-cache/modules-2/gc.properties; \
    chmod -R a-w /opt/gradle/ro-cache; \
    find /opt/gradle/warm/wrapper/dists -name '*.zip' -delete
ENV GRADLE_RO_DEP_CACHE=/opt/gradle/ro-cache

# Prove the offline paths at image build time. First the grader's: fresh home,
# read-only cache, pinned binary, no network; the check is that JUnit XML was
# written. Then the agent's: ./gradlew must still work from the warm home with
# the distribution zip deleted (the wrapper only needs the unpacked
# distribution and its .ok marker).
RUN GRADLE_USER_HOME=/tmp/probe-home \
      /opt/gradle/dist/bin/gradle --offline --no-daemon --console=plain --continue {test_tasks}; \
    {probe_check} \
 && ./gradlew --offline --no-daemon --console=plain help > /dev/null \
 && rm -rf /tmp/probe-home && ./gradlew --no-daemon --console=plain clean > /dev/null \
 && rm -rf .gradle .kotlin

# A non-root user for the agent phase. Harbor runs agents as root unless
# task.toml sets [agent].user; the spec's environment.agent_user does that.
RUN useradd -m -u 1000 agent && chown -R agent:agent /app /opt/gradle/warm
